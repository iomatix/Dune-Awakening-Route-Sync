# 1. Ignore everything by default
/*

# 2. Whitelist repository configurations and essential project files
!.gitignore
!README.md
!config.json

# 3. Whitelist generalized Python network engine and test suite
!dune_net.py
!test_dune_net.py

# 4. Whitelist batch execution runners
!run_dune_net.bat
!run_tests.bat

# 5. Local environments & editor
.venv/
venv/
.idea/
.vscode/

# 6. Explicitly ignore Python runtime artifacts in case of subfolder inclusions
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.log
.pytest_cache/
.coverage
htmlcov/
*.tmp
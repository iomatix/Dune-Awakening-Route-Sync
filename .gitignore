# 1. Ignore everything by default
/*

# 2. Whitelist repository configurations and project files
!.gitignore
!README.md
!config.json
!config.ops.json
!pyproject.toml

# 3. Whitelist core network engine and scripts
!dune_net.py
!test_dune_net.py
!run_dune_net.bat
!run_dune_ops.bat
!run_tests.bat

# 4. Whitelist operator console and tests
!dune_ops/
!dune_ops/**
!tests/
!tests/**

# 5. Local environments & IDE
.venv/
venv/
.idea/
.vscode/

# 6. Python & Packaging build artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.log
*.tmp
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/